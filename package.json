{
  "name": "@ovaultd/plugin",
  "version": "0.1.0",
  "description": "Obsidian plugin for ovaultd — self-hosted, end-to-end encrypted sync.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "install:dev": "node scripts/install-dev.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@ovaultd/core": "file:../ovaultd/packages/core",
    "@ovaultd/crypto": "file:../ovaultd/packages/crypto",
    "@ovaultd/protocol": "file:../ovaultd/packages/protocol"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
